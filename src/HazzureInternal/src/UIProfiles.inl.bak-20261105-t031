        g_cfg.cameraFovOverride = false;
        g_cfg.cameraFov = 90.f;
        g_cfg.thirdpersonEnabled = false;
        g_cfg.aspectRatioOverride = false;
    } else if (type == 1) { // Semi-Rage
        g_cfg.aimActive = true;
