        g_cfg.aimSmooth = 2.0f;
        g_cfg.aimBone = 0;
        g_cfg.rcsActive = true;
        g_cfg.espEnabled = true;
        g_cfg.espBoxes = true;
        g_cfg.espBoxType = 0;
        g_cfg.espSkeleton = true;
        g_cfg.espSnaplines = true;
        g_cfg.offScreenArrows = true;
        g_cfg.cameraFovOverride = true;
        g_cfg.cameraFov = 105.f;
        g_cfg.thirdpersonEnabled = true;
        g_cfg.thirdpersonDistance = 140.f;
        g_cfg.aspectRatioOverride = false;
    } else if (type == 2) { // Apenas Visuais
        g_cfg.aimActive = false;
        g_cfg.rcsActive = false;
        g_cfg.espEnabled = true;
        g_cfg.espBoxes = true;
        g_cfg.espBoxType = 1;
        g_cfg.espSkeleton = true;
        g_cfg.offScreenArrows = true;
        g_cfg.cameraFovOverride = false;
        g_cfg.thirdpersonEnabled = false;
        g_cfg.aspectRatioOverride = false;
    }
}

