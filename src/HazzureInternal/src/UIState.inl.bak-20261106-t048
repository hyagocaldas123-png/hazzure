enum BoneIndex : int {
    BONE_PELVIS = 0,
    BONE_SPINE_1 = 2,
    BONE_SPINE_2 = 4, // Peito / Chest
    BONE_NECK = 5,    // Pescoco / Neck
    BONE_HEAD = 6,    // Cabeca / Head
    BONE_ANKLE_L = 19,
    BONE_ANKLE_R = 22
};

static bool ReadBonePos(uintptr_t boneArray, int boneIdx, Vec3* outPos) {
    if (!boneArray || boneIdx < 0 || boneIdx > 64 || !outPos) return false;
    Vec3 p{};
    if (!SafeRead(boneArray + static_cast<uintptr_t>(boneIdx) * 32u, &p)) return false;
    if (!std::isfinite(p.x) || !std::isfinite(p.y) || !std::isfinite(p.z)) return false;
    if (p.x == 0.f && p.y == 0.f && p.z == 0.f) return false;
    *outPos = p;
    return true;
}

static uintptr_t ResolveValidatedBoneArray(uintptr_t gameScene, const Vec3& origin) {
    if (!gameScene) return 0;
    const uintptr_t candidates[2] = {
        gameScene + HazzureOffsets::Schema::m_modelState + 0x80,
        gameScene + 0x160 + 0x80
    };
    for (uintptr_t ptrAddr : candidates) {
        uintptr_t boneArray = 0;
        if (!SafeRead(ptrAddr, &boneArray) || boneArray < 0x10000) continue;
        Vec3 pelvis{}, chest{}, head{};
        if (!ReadBonePos(boneArray, BONE_PELVIS, &pelvis) ||
            !ReadBonePos(boneArray, BONE_SPINE_2, &chest) ||
            !ReadBonePos(boneArray, BONE_HEAD, &head)) {
            continue;
        }
        float horizPelvis = std::hypot(pelvis.x - origin.x, pelvis.y - origin.y);
        float horizHead   = std::hypot(head.x - origin.x, head.y - origin.y);
        float relHeadZ    = head.z - origin.z;
        float spineSpan   = head.z - pelvis.z;
        if (horizPelvis < 96.f && horizHead < 96.f &&
            relHeadZ >= 16.f && relHeadZ <= 92.f &&
            spineSpan >= 8.f && spineSpan <= 68.f) {
            return boneArray;
        }
    }
    return 0;
}

static const char* GameInputBlockReason(bool menuOpen) {
    bool capture=false;
    if(ImGui::GetCurrentContext()){auto& io=ImGui::GetIO();capture=io.WantCaptureKeyboard||io.WantTextInput;}
    if(menuOpen||capture)return HazzureInputContext::BlockReason(menuOpen,capture,true,true);
    HWND foreground=GetForegroundWindow();DWORD pid{};if(foreground)GetWindowThreadProcessId(foreground,&pid);
    return HazzureInputContext::BlockReason(false,false,foreground!=nullptr,pid==GetCurrentProcessId());
}
static bool IsGameInputActive(bool menuOpen) {return !strcmp(GameInputBlockReason(menuOpen),"ready");}

