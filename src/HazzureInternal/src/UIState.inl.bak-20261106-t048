static bool WorldToScreen(const Vec3& p, const Matrix4& matrix, int width, int height, Vec2& result) {
    // Always use the matrix actually delivered by the game; an independent
    // horizontal scale would move ESP away from the native scene.
    return HazzureGame::Project(p,matrix,width,height,result);
}

