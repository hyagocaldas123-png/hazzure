template<typename T>
static bool SafeRead(uintptr_t addr, T* out) {
    return out&&HazzureGame::ReadBytes(addr,out,sizeof(T));
}
[[maybe_unused]] static uintptr_t SafeReadPointer(uintptr_t addr) {
    uintptr_t v=0; return HazzureGame::ReadBytes(addr,&v,sizeof(v))?v:0;
}
template<typename T>
static bool SafeWrite(uintptr_t addr, const T& val) {
    return HazzureGame::WriteBytes(addr,&val,sizeof(T));
}

