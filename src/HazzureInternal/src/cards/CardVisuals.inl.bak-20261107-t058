inline void DrawVisualsPlayerEspCard(Shared* shared) {
    BeginCleanCard("ESP Jogadores", "DINAMICO");
    if (shared) {
        LONG curF = InterlockedCompareExchange(&shared->flags, 0, 0);
        ImGui::TextColored(kMuted, "Configurado: Chams %s | ESP %s", (curF & 1) ? "ON" : "OFF", (curF & 8) ? "ON" : "OFF");
        ImGui::Separator();
    }
    bool espOn = g_cfg.espEnabled;
    if (CleanToggle("ESP Ativo (Master)", &espOn)) {
        g_cfg.espEnabled = espOn;
        if (shared) {
            if (espOn) InterlockedOr(&shared->flags, 8);
            else InterlockedAnd(&shared->flags, ~8);
            LogDebug("[UI] Toggle ESP Ativo -> flags=0x%lX", InterlockedCompareExchange(&shared->flags, 0, 0));
        }
    }
    bool boxOn = g_cfg.espBoxes;
    if (CleanToggle("Caixas Dinamicas por Osso", &boxOn)) {
        g_cfg.espBoxes = boxOn;
        if (shared) {
            if (boxOn) InterlockedOr(&shared->flags, 16);
            else InterlockedAnd(&shared->flags, ~16);
            LogDebug("[UI] Toggle Caixas ESP -> flags=0x%lX", InterlockedCompareExchange(&shared->flags, 0, 0));
        }
    }
    if (g_cfg.espBoxes) {
        const char* boxTypes[] = { "Caixa Completa", "Cantoneiras (Corner)" };
        CleanCombo("Estilo da Caixa", &g_cfg.espBoxType, boxTypes, 2);
    }
    bool skelOn = g_cfg.espSkeleton;
    if (CleanToggle("Esqueleto 3D Validado", &skelOn)) {
        g_cfg.espSkeleton = skelOn;
        if (shared) {
            if (skelOn) InterlockedOr(&shared->flags, 32);
            else InterlockedAnd(&shared->flags, ~32);
            LogDebug("[UI] Toggle Esqueleto -> flags=0x%lX", InterlockedCompareExchange(&shared->flags, 0, 0));
        }
    }
    CleanToggle("Barra de Vida", &g_cfg.espHealth);
    CleanToggle("Barra de Armadura", &g_cfg.espShowArmor);
    CleanToggle("Flags Taticas (Reload/Kit/Pin/Imune/C4)", &g_cfg.espFlagsExtras);
    CleanToggle("Animacao Suave do ESP (Fade/Barras)", &g_cfg.espSmoothAnimations);
    CleanToggle("Nome do Jogador", &g_cfg.espName);
    CleanToggle("Arma Equipada", &g_cfg.espWeapon);
    if (g_cfg.espWeapon) CleanToggle("Icones de Armas", &g_cfg.espWeaponIcons);
    CleanToggle("Distancia em Metros", &g_cfg.espDistance);
    CleanSliderFloat("Alcance ESP", &g_cfg.espMaxDistance, 100.f, 20000.f, "%.0f u");
    CleanToggle("Linhas de Snap", &g_cfg.espSnaplines);
    CleanToggle("Setas Fora de Tela", &g_cfg.offScreenArrows);
    if (shared) {
        ImGui::Separator();
        bool chamsQuick = (InterlockedCompareExchange(&shared->flags, 0, 0) & 1) != 0;
        if (CleanToggle("Chams Visivel (Rapido)", &chamsQuick)) {
            if (chamsQuick) InterlockedOr(&shared->flags, 1);
            else InterlockedAnd(&shared->flags, ~1);
        }
    }
    EndCleanCard();
}

inline void DrawVisualsWorldTacticCard() {
