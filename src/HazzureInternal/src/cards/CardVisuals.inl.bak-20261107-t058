        CleanToggle("Cintilacao Suave", &g_cfg.trajectoryShimmer);
        CleanSliderFloat("Espessura da Trajetoria", &g_cfg.trajectoryWidth, .5f, 5.f, "%.1f px");
        CleanSliderFloat("Pontos de Colisao", &g_cfg.trajectoryPointSize, 1.f, 8.f, "%.1f px");
        CleanSliderFloat("Opacidade da Trajetoria", &g_cfg.trajectoryOpacity, .1f, 1.f, "%.2f");
        CleanColorRow("Cor da Trajetoria", g_cfg.colTrajectory);
        CleanColorRow("Cor das Colisoes", g_cfg.colTrajectoryCollision);
        ImGui::TreePop();
    }
    if (ImGui::TreeNode("Estilo dos Disparos")) {
        CleanColorRow("Cor dos Tracers", g_cfg.colTracer);
