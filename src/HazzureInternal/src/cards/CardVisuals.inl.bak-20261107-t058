    CleanToggle("Timer da C4", &g_cfg.showBombTimer);
    CleanToggle("Aviso de Bomba Plantada", &g_cfg.bombPlantedNotify);
    CleanToggle("Sem Borda do Scope (AWP/SSG)", &g_cfg.noScopeOverlay);
    CleanToggle("Linhas Limpas do Scope Sniper", &g_cfg.cleanSniperScopeLines);
    CleanToggle("ESP Defuser / Refens / Resgate", &g_cfg.espDefuserHostage);
    CleanToggle("Event Logs na Tela (Dano/Kills/C4)", &g_cfg.eventLogsScreen);
    CleanToggle("Scoreboard Override (Tabela Tatica TAB)", &g_cfg.scoreboardRevealAll);
    CleanToggle("Raio Individual por Granada (3D)", &g_cfg.grenadeIndividualRadius);
    if (g_cfg.grenadeIndividualRadius) {
        CleanSliderFloat("Raio da Smoke", &g_cfg.smokeRadiusUnits, 60.f, 260.f, "%.0f u");
        CleanSliderFloat("Raio do Molotov", &g_cfg.molotovRadiusUnits, 60.f, 260.f, "%.0f u");
    }
