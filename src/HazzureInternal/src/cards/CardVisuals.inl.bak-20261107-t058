inline void DrawVisualsChamsCard(Shared* shared) {
    BeginCleanCard("Chams de Jogadores", "SOURCE 2");
    if (shared) {
        LONG curFlags = InterlockedCompareExchange(&shared->flags, 0, 0);
        ImGui::TextColored(kMuted, "Visivel:%d | Oculto:%d | Bracos:%d", (curFlags & 1) ? 1 : 0, (curFlags & 2) ? 1 : 0, (curFlags & 4) ? 1 : 0);
        ImGui::Separator();

        bool vis = (curFlags & 1) != 0;
        if (CleanToggle("Chams Visivel", &vis)) {
            if (vis) InterlockedOr(&shared->flags, 1);
            else InterlockedAnd(&shared->flags, ~1);
        }
        float cVis[4]; IpcColToFloat4(shared->visibleColour, cVis);
        if (CleanColorRow("Cor Visivel", cVis)) shared->visibleColour = Float4ToIpcCol(cVis);

        curFlags = InterlockedCompareExchange(&shared->flags, 0, 0);
        bool hid = (curFlags & 2) != 0;
        if (CleanToggle("Chams Oculto (Parede)", &hid)) {
            if (hid) InterlockedOr(&shared->flags, 2);
            else InterlockedAnd(&shared->flags, ~2);
        }
        float cHid[4]; IpcColToFloat4(shared->hiddenColour, cHid);
        if (CleanColorRow("Cor Oculto", cHid)) shared->hiddenColour = Float4ToIpcCol(cHid);

        curFlags = InterlockedCompareExchange(&shared->flags, 0, 0);
        bool arms = (curFlags & 4) != 0;
        if (CleanToggle("Chams Bracos / Luvas", &arms)) {
            if (arms) InterlockedOr(&shared->flags, 4);
            else InterlockedAnd(&shared->flags, ~4);
        }
        float cArms[4]; IpcColToFloat4(shared->armsColour, cArms);
        if (CleanColorRow("Cor Bracos", cArms)) shared->armsColour = Float4ToIpcCol(cArms);

        CleanToggle("Chams Arma 1P (Viewmodel)", &g_cfg.chamsWeapon);
        bool tf = (shared->teamFilter != 0);
        if (CleanToggle("Apenas Inimigos", &tf)) InterlockedExchange(&shared->teamFilter, tf ? 1 : 0);
    }
    EndCleanCard();
}

inline void DrawVisualsChamsGradientCard(Shared* shared) {
    BeginCleanCard("Gradiente Hermite", "2 PASSADAS");
    if (shared) {
        bool grad = InterlockedCompareExchange(&shared->gradient, 0, 0) != 0;
        if (CleanToggle("Ativar Gradiente Vertical", &grad)) InterlockedExchange(&shared->gradient, grad ? 1 : 0);
        float cVis[4], cGrad[4];
        IpcColToFloat4(shared->visibleColour, cVis);
        IpcColToFloat4(shared->gradientColour, cGrad);
        if (CleanColorRow("Cor Base do Gradiente", cGrad)) shared->gradientColour = Float4ToIpcCol(cGrad);

        ImGui::Dummy(ImVec2(0.f, 4.f));
        ImVec2 gp = ImGui::GetCursorScreenPos();
        ImU32 topC = Float4ToImU32(cVis);
        ImU32 botC = Float4ToImU32(cGrad);
        ImGui::GetWindowDrawList()->AddRectFilledMultiColor(gp, ImVec2(gp.x + g_cleanCardContentW, gp.y + 14.f), topC, topC, botC, botC);
        ImGui::GetWindowDrawList()->AddRect(gp, ImVec2(gp.x + g_cleanCardContentW, gp.y + 14.f), IM_COL32(46, 46, 55, 255));
        ImGui::Dummy(ImVec2(g_cleanCardContentW, 18.f));
    }
    EndCleanCard();
}

inline void DrawVisualsChamsMaterialCard(Shared* shared) {
    BeginCleanCard("Estilo de Material & Outline", "D3D11 / SHADER");
    static const char* kMatStyles[] = { "Flat (Matte)", "Metallic (Cromo / Reflexo)", "Wireframe (Malha)", "Fresnel Glow (Borda Neon)", "Cristal (Vidro)" };
    if (CleanCombo("Material Visivel", &g_cfg.chamsVisibleStyle, kMatStyles, 5)) {
        if (shared) InterlockedExchange(&shared->chamsVisibleStyle, g_cfg.chamsVisibleStyle);
    }
    if (CleanCombo("Material Oculto (Parede)", &g_cfg.chamsHiddenStyle, kMatStyles, 5)) {
        if (shared) InterlockedExchange(&shared->chamsHiddenStyle, g_cfg.chamsHiddenStyle);
    }
    ImGui::TextWrapped("Estilo MemeSense: visivel e oculto usam material e cor independentes.");
    CleanToggle("Efeito Dupla Camada (Overlay Wireframe)", &g_cfg.chamsDualLayer);
    CleanToggle("Chams em Ragdolls (Corpos)", &g_cfg.chamsRagdoll);
    CleanToggle("On-Shot Chams (Capsula do Disparo)", &g_cfg.chamsOnShot);
    CleanToggle("Sky Chams (Modulacao 3D Sky)", &g_cfg.chamsSky);
    CleanToggle("Contorno Brilhante (Outline Glow)", &g_cfg.glowOutline);
    EndCleanCard();
}

