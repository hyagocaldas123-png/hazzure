    if (g_cfg.killfeedEnabled) {
        CleanToggle("Apenas Eliminacoes Locais", &g_cfg.killfeedLocalOnly);
        CleanSliderFloat("Duracao na Tela", &g_cfg.killfeedDuration, 0.f, 120.f, "%.1f s");
        float linesF = static_cast<float>(g_cfg.killfeedLines);
