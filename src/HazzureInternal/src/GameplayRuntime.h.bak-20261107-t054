                 :std::clamp(RuntimeFloat("aimFov",g_cfg.aimFov,"enemy",weaponClass),.1f,45.f);
    bool aimEnabled=rage||RuntimeBool("aimActive",g_cfg.aimActive,"enemy",weaponClass);
