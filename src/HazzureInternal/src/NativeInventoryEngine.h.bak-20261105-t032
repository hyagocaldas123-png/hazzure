inline bool KnownKnife(int d){for(int v:kKnifeDefs)if(v&&v==d)return true;return d==42||d==59;}
inline bool KnownGlove(int d){return d==4725||d==5027||(d>=5030&&d<=5035);}
inline int NativeDefinition(const HazzureInventory::Item& item){
    int d=item.skin.definition;if(KnownKnife(d)&&KnownKnife(item.skin.model))return item.skin.model;return d;
}
inline bool KnownDefinition(const HazzureInventory::Item& item){
    int d=NativeDefinition(item);
    if(KnownKnife(item.skin.definition)){if(item.skin.model&&!KnownKnife(item.skin.model))return false;}
    else if(KnownGlove(d)){if(item.skin.model&&item.skin.model!=d)return false;}
    else if(item.skin.model)return false;
    bool known=KnownKnife(d)||KnownGlove(d);for(int w:HazzureWeapons::definitions)known=known||(w==d&&w>0);
    if(!known)return false;
    if(KnownGlove(d))return HazzureGloves::ValidPaint(d,item.skin.paint);
    if(!item.skin.paint)return true;
    if(KnownKnife(d)&&HazzureKnifeFinishes::ValidPaint(d,item.skin.paint))return true;
    for(const auto& s:kSkins)if(s.kit==item.skin.paint&&(s.def==d||(KnownKnife(d)&&s.def==-1)))return true;return false;
}
inline bool TeamAllowedForDefinition(int d,int team){
    if(team!=2&&team!=3)return false;
    switch(d){
        case 4:case 11:case 13:case 17:case 29:case 30:case 39:case 59:return team==2;
        case 3:case 8:case 10:case 16:case 27:case 32:case 34:case 38:case 42:case 60:case 61:return team==3;
        default:return true;
    }
}
inline int DefaultSlotForDefinition(int d,int team){
    if(!TeamAllowedForDefinition(d,team))return -1;
    if(KnownKnife(d))return 0;
    if(KnownGlove(d))return 41;
    switch(d){
        case 4:case 32:case 61:return 2;
        case 2:case 63:case 64:return 3;
        case 36:return 4;
        case 3:case 30:return 5;
        case 1:return 6;
        case 24:case 26:case 33:return 8;
        case 25:case 27:case 29:return 9;
        case 23:case 35:return 10;
        case 14:case 19:case 28:return 11;
        case 17:case 34:return 12;
        case 10:case 13:case 16:return 14;
        case 7:case 60:return 15;
        case 40:return 16;
        case 8:case 39:case 11:case 38:return 17;
        case 9:return 18;
        case 31:return 34;
        default:return -1;
    }
}
