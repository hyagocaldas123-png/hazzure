        b.loadout=[](void* p,const Session& s,int team,int slot,uint64_t& id){return static_cast<Engine*>(p)->Loadout(s,team,slot,id);};
        b.equip=[](void* p,const Session& s,int team,int slot,uint64_t id){return static_cast<Engine*>(p)->Equip(s,team,slot,id);};
        return b;
    }
};
