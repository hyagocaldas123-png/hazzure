static bool CatalogWeaponInSubTab(int def, int subTab) {
    if (subTab == 0) return HazzureArmory::KnifeDefinition(def);
    if (subTab == 6) return HazzureInventory::Glove(def);
    if (subTab == 1) {
        switch (def) { case 1: case 2: case 3: case 4: case 30: case 32: case 36: case 61: case 63: case 64: return true; default: return false; }
    }
    if (subTab == 2) {
        switch (def) { case 14: case 17: case 19: case 23: case 24: case 25: case 26: case 27: case 28: case 29: case 33: case 34: case 35: return true; default: return false; }
    }
    if (subTab == 3) {
        switch (def) { case 7: case 8: case 10: case 13: case 16: case 39: case 60: return true; default: return false; }
    }
    if (subTab == 4) {
        switch (def) { case 9: case 11: case 31: case 38: case 40: return true; default: return false; }
    }
    return false;
}

static const char* WeaponLabelByDef(int def) {
    for (int i = 0; i < HazzureWeapons::count; ++i) {
        if (HazzureWeapons::definitions[i] == def) return HazzureWeapons::names[i];
    }
    for (size_t i = 1; i < IM_ARRAYSIZE(kKnifeDefs); ++i) {
        if (kKnifeDefs[i] == def) return kKnifeNames[i];
    }
    if (HazzureInventory::Glove(def)) return HazzureGloves::FamilyName(def);
    return "Arma";
}

static void AddCatalogItemToCollection(int def, int paint, float wear, const char* weaponName, const char* paintName) {
    HazzureInventory::Item item{};
    item.skin.definition = def;
    item.skin.model = (HazzureArmory::KnifeDefinition(def) || HazzureInventory::Glove(def)) ? def : 0;
    item.skin.paint = paint;
    item.skin.wear = std::clamp(wear, 0.0f, 1.0f);
    item.skin.seed = 1;
    item.skin.enabled = 1;
    item.attributes.definition = def;
    snprintf(item.label, sizeof(item.label), "%s | %s", weaponName ? weaponName : "Item", paintName ? paintName : "Custom");
    for (char* p = item.label; *p; ++p) {
        if (static_cast<unsigned char>(*p) < 32 || static_cast<unsigned char>(*p) == 127) *p = ' ';
    }
    uint64_t createdId = 0;
    if (HazzureInventory::Add(g_cfg.inventory, item, &createdId)) {
        g_inventorySelected = createdId;
        g_inventoryDraft = item;
        g_inventoryDraft.id = createdId;
        g_inventoryOpenEditor = false;
        g_inventorySubTab = 0;
        HazzureInventory::EquipItem(g_cfg.inventory, createdId, true, true);
        HazzureNativeInventory::Request(g_cfg.inventory);
        HazzureNativeInventory::RequestEquipBoth(createdId);
        sprintf_s(g_configStatusMsg, "Adicionado e equipado: %s", item.label);
    } else {
        sprintf_s(g_configStatusMsg, "Colecao cheia (96/96) ou item invalido");
    }
}

static void DrawGraphicArtTab(Shared* shared) {
    DrawGraphicArtTabButtons();
    static char catSearch[80]{};
    ImGui::SetNextItemWidth(ImGui::GetContentRegionAvail().x);
    ImGui::InputTextWithHint("##CatalogSearch", "Buscar no catalogo...", catSearch, sizeof(catSearch));

    static int selectedKnifeIdx = 3; // Karambit default
    static const int knives19[] = { 500,505,506,507,508,509,512,514,515,516,517,518,519,520,521,522,523,525,526 };
    static const char* knifeNames19[] = {
        "Bayonet","Flip Knife","Gut Knife","Karambit","M9 Bayonet","Huntsman Knife",
        "Falchion Knife","Bowie Knife","Butterfly Knife","Shadow Daggers","Paracord Knife",
        "Survival Knife","Ursus Knife","Navaja Knife","Nomad Knife","Stiletto Knife",
        "Talon Knife","Skeleton Knife","Kukri Knife"
    };
    if (g_graphicArtSubTab == 0) {
        GSWidgets::GS_Combo("Modelo da faca", &selectedKnifeIdx, knifeNames19, IM_ARRAYSIZE(knives19));
        bool secretAnim = RuntimeBool("secretKnifeAnim", g_cfg.secretKnifeAnim, "enemy", "");
        if (ImGui::Checkbox("Animações Secretas", &secretAnim)) {
            g_cfg.secretKnifeAnim = secretAnim;
            ApplySharedConfig(shared);
        }
    }

    if (g_graphicArtSubTab == 5) DrawAgentsInlineSection(shared);

    float availW = ImGui::GetContentRegionAvail().x;
    const float slotSize = 136.0f;
    const float spacing = 10.0f;
    int columns = static_cast<int>(std::max(1.0f, std::floor((availW + spacing) / (slotSize + spacing))));
    const float gridH = std::max(160.f, ImGui::GetContentRegionAvail().y - 8.f);

    ImGui::BeginChild("##catalogBrowserGrid", ImVec2(0, gridH), false);
    ImGui::Columns(columns, "##catcols", false);

    size_t shown = 0;
    if (g_graphicArtSubTab == 0) {
        int kDef = knives19[std::clamp(selectedKnifeIdx, 0, static_cast<int>(IM_ARRAYSIZE(knives19)) - 1)];
        const char* kLabel = knifeNames19[std::clamp(selectedKnifeIdx, 0, static_cast<int>(IM_ARRAYSIZE(knifeNames19)) - 1)];
        for (size_t i = 0; i < IM_ARRAYSIZE(HazzureKnifeFinishes::kCatalog); ++i) {
            const auto& kf = HazzureKnifeFinishes::kCatalog[i];
            if (kf.definition != 0 && kf.definition != kDef) continue;
            std::string matchText = std::string(kLabel) + " " + kf.name + " " + std::to_string(kf.paint);
            if (catSearch[0] && !Workflow::Matches(matchText.c_str(), catSearch)) continue;
            ++shown;
            char slotId[48];
            sprintf_s(slotId, "cat_knife_%d_%d", kDef, kf.paint);
            auto thumb = HazzurePreviewAssets::GetWeaponThumbnail(kDef, kf.paint);
            bool sel = false;
            if (GSWidgets::GS_InventorySlot(slotId, kLabel, kf.name, &sel, reinterpret_cast<ImTextureID>(thumb.view), kf.defaultWear, 1, thumb.width, thumb.height, "+")) {
                AddCatalogItemToCollection(kDef, kf.paint, kf.defaultWear, kLabel, kf.name);
            }
            ImGui::NextColumn();
        }
    } else if (g_graphicArtSubTab == 6) {
        for (size_t i = 0; i < IM_ARRAYSIZE(HazzureGloves::kCatalog); ++i) {
            const auto& gf = HazzureGloves::kCatalog[i];
            const char* fam = HazzureGloves::FamilyName(gf.definition);
            std::string matchText = std::string(fam) + " " + gf.name + " " + std::to_string(gf.paint);
            if (catSearch[0] && !Workflow::Matches(matchText.c_str(), catSearch)) continue;
            ++shown;
            char slotId[48];
            sprintf_s(slotId, "cat_glove_%d_%d", gf.definition, gf.paint);
            auto thumb = HazzurePreviewAssets::GetWeaponThumbnail(gf.definition, gf.paint);
            bool sel = false;
            const char* shortPaint = strchr(gf.name, '|');
            shortPaint = shortPaint ? (shortPaint + 2) : gf.name;
            if (GSWidgets::GS_InventorySlot(slotId, fam, shortPaint, &sel, reinterpret_cast<ImTextureID>(thumb.view), 0.08f, 1, thumb.width, thumb.height, "+")) {
                AddCatalogItemToCollection(gf.definition, gf.paint, 0.08f, fam, shortPaint);
            }
            ImGui::NextColumn();
        }
    } else if (g_graphicArtSubTab == 5) {
        for (size_t i = 1; i < IM_ARRAYSIZE(kPreviewAgentsCT); ++i) {
            const auto& ag = kPreviewAgentsCT[i];
            if (!ag.model[0]) continue;
            if (catSearch[0] && !Workflow::Matches(ag.name, catSearch)) continue;
            ++shown;
            char slotId[48];
            sprintf_s(slotId, "cat_agent_ct_%zu", i);
            auto thumb = HazzurePreviewAssets::Get(ag.asset);
            bool active = g_cfg.agentEnabled && g_cfg.agentCT == static_cast<int>(i);
            if (GSWidgets::GS_InventorySlot(slotId, ag.name, "Contra-Terrorista", &active, reinterpret_cast<ImTextureID>(thumb.view), 0.0f, static_cast<int>(i), thumb.width, thumb.height, active ? "CT" : nullptr)) {
                // Card ativo de novo = desligar; sem isso nao havia nenhuma forma de sair do agent changer.
                g_cfg.agentEnabled = !(g_cfg.agentEnabled && g_cfg.agentCT == static_cast<int>(i));
                g_cfg.agentCT = static_cast<int>(i);
                ApplySharedConfig(shared);
            }
            ImGui::NextColumn();
        }
        for (size_t i = 1; i < IM_ARRAYSIZE(kPreviewAgentsT); ++i) {
            const auto& ag = kPreviewAgentsT[i];
            if (!ag.model[0]) continue;
            if (catSearch[0] && !Workflow::Matches(ag.name, catSearch)) continue;
            ++shown;
            char slotId[48];
            sprintf_s(slotId, "cat_agent_t_%zu", i);
            auto thumb = HazzurePreviewAssets::Get(ag.asset);
            bool active = g_cfg.agentEnabled && g_cfg.agentT == static_cast<int>(i);
            if (GSWidgets::GS_InventorySlot(slotId, ag.name, "Terrorista", &active, reinterpret_cast<ImTextureID>(thumb.view), 0.0f, static_cast<int>(i), thumb.width, thumb.height, active ? "TR" : nullptr)) {
                g_cfg.agentEnabled = !(g_cfg.agentEnabled && g_cfg.agentT == static_cast<int>(i));
                g_cfg.agentT = static_cast<int>(i);
                ApplySharedConfig(shared);
            }
            ImGui::NextColumn();
        }
    } else {
        for (size_t i = 0; i < IM_ARRAYSIZE(kSkins); ++i) {
            const auto& sk = kSkins[i];
            if (!CatalogWeaponInSubTab(sk.def, g_graphicArtSubTab)) continue;
            const char* wName = WeaponLabelByDef(sk.def);
            std::string matchText = std::string(wName) + " " + sk.name + " " + std::to_string(sk.kit);
            if (catSearch[0] && !Workflow::Matches(matchText.c_str(), catSearch)) continue;
            ++shown;
            char slotId[48];
            sprintf_s(slotId, "cat_wep_%d_%d_%zu", sk.def, sk.kit, i);
            auto thumb = HazzurePreviewAssets::GetWeaponThumbnail(sk.def, sk.kit);
            bool sel = false;
            const char* shortPaint = strchr(sk.name, '|');
            shortPaint = shortPaint ? (shortPaint + 2) : sk.name;
            if (GSWidgets::GS_InventorySlot(slotId, wName, shortPaint, &sel, reinterpret_cast<ImTextureID>(thumb.view), sk.wear, sk.seed, thumb.width, thumb.height, "+")) {
                AddCatalogItemToCollection(sk.def, sk.kit, sk.wear, wName, shortPaint);
            }
            ImGui::NextColumn();
        }
    }

    ImGui::Columns(1);
    if (!shown) {
        ImGui::TextDisabled("Nenhum item do catalogo corresponde ao filtro.");
    }
    ImGui::EndChild();
}

static void DrawLocalInventory(Shared* shared) {
    if (g_inventorySubTab < 0 || g_inventorySubTab > 4 || g_inventorySubTab == 2 || g_inventorySubTab == 3) g_inventorySubTab = 0;
    g_graphicArtSubTab = std::clamp(g_graphicArtSubTab, 0, 6);
    DrawInventoryTabButtons();

    switch (g_inventorySubTab) {
        case 0: DrawProfileTab(shared); break;
        case 1: DrawEquipmentTab(shared); break;
        case 2: DrawContainersTab(shared); break;
        case 3: DrawToolsTab(shared); break;
        case 4: DrawGraphicArtTab(shared); break;
    }
}
