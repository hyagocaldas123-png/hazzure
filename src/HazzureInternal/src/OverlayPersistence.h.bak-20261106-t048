static std::string RegisteredGlobalValue(const std::string& name) {
    for(const auto& field:Persistence::boolFields)if(name==field.name)return g_cfg.*field.member?"1":"0";
    for(const auto& field:Persistence::intFields)if(name==field.name)return std::to_string(g_cfg.*field.member);
    for(const auto& field:Persistence::floatFields)if(name==field.name)return std::to_string(g_cfg.*field.member);
    for(const auto& field:Persistence::colourFields)if(name==field.name){
        HazzureConfig::Document document;auto& root=document.Root();
        HazzureConfig::SetFloatArray(root,"value",g_cfg.*field.member,4,document.Allocator());
        const auto* value=HazzureConfig::Find(root,"value");return value?Persistence::Text(*value):std::string();
    }
    return {};
}

static bool RuntimeBool(const char* name,bool fallback,const char* context,const char* weaponClass) {
    if(!Persistence::Registered(name))return fallback;
    std::string value=FindVar(std::string(name),std::string(context?context:""),std::string(weaponClass?weaponClass:""));
    if(value=="1"||value=="true")return true;if(value=="0"||value=="false")return false;return fallback;
}
static float RuntimeFloat(const char* name,float fallback,const char* context,const char* weaponClass) {
    if(!Persistence::Registered(name))return fallback;
    std::string value=FindVar(std::string(name),std::string(context?context:""),std::string(weaponClass?weaponClass:""));
    if(value.empty())return fallback;
    char* end=nullptr;double number=strtod(value.c_str(),&end);
    if(end==value.c_str()||!end||*end!='\0'||!std::isfinite(number)||number>1e8||number< -1e8)return fallback;
    for(const auto& field:Persistence::floatFields)if(!strcmp(name,field.name)&&
        (number<field.minimum||number>field.maximum))return fallback;
    for(const auto& field:Persistence::intFields)if(!strcmp(name,field.name)&&
        (number<field.minimum||number>field.maximum||std::trunc(number)!=number))return fallback;
    return static_cast<float>(number);
}

// Canonical persisted values, never struct bytes or runtime diagnostics. Poll only while
// the menu is visible; explicit IO always refreshes the baseline immediately.
namespace Workflow {
static std::string savedState;
static bool hasSavedState=false, dirty=true;
static double nextCheck=0, savedNoticeUntil=0;
static bool Canonical(std::string& text) {
    HazzureConfig::Document document;std::string error;
    return Persistence::WriteConfig(document,g_cfg,g_contexts,g_weaponClasses,g_profiles,g_activeProfileIndex,error)&&document.Serialize(text,error);
}
static void MarkSaved() {
    hasSavedState=Canonical(savedState);dirty=!hasSavedState;nextCheck=0;
}
static void Poll(double now,bool force=false) {
    if(!force&&now<nextCheck)return;
    nextCheck=now+.5;std::string state;
    dirty=!hasSavedState||!Canonical(state)||state!=savedState;
}
static const char* ProfileName() {
    return g_activeProfileIndex>=0&&g_activeProfileIndex<static_cast<int>(g_profiles.size())?
        g_profiles[g_activeProfileIndex].name.c_str():"Personalizado (sem perfil)";
