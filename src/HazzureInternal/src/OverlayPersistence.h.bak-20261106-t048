static bool SaveConfigFile(const char* path="C:\\HazzureKernel\\hazzure_config.json") {
    if(!path||!*path){Persistence::Status("Caminho de configuracao invalido");return false;}
    if(!CaptureSharedConfig(g_settingsShared)){Persistence::Status("Configuracao IPC ocupada; tente novamente");return false;}
    HazzureConfig::Document candidate;std::string error;
    if(Persistence::storagePath==path)candidate=Persistence::storage;
    else if(!candidate.Load(path,error,true)){Persistence::Status(error);return false;}
    int version=1;
    if(HazzureConfig::Find(candidate.Root(),"schemaVersion")&&
       !HazzureConfig::GetInt(candidate.Root(),"schemaVersion",version,1,3)){Persistence::Status("schemaVersion nao suportada");return false;}
    bool exists=GetFileAttributesW(HazzureConfig::Detail::Normalize(path).c_str())!=INVALID_FILE_ATTRIBUTES;
    if(!Persistence::WriteConfig(candidate,g_cfg,g_contexts,g_weaponClasses,g_profiles,g_activeProfileIndex,error)||
       !candidate.SaveAtomic(path,error,exists&&version<3?version:0)){Persistence::Status(error);return false;}
    Persistence::storage=candidate;Persistence::storagePath=path;Workflow::MarkSaved();
    Workflow::savedNoticeUntil=ImGui::GetCurrentContext()?ImGui::GetTime()+3:0;
    Persistence::Status("Configuracao completa salva (v3)");return true;
}

