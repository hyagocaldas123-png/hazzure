static bool CaptureSharedConfig(Shared* shared) {
    if(!shared)return true;
    OverlayConfig candidate=g_cfg;
    LONG revision=InterlockedCompareExchange(&shared->revision,0,0);if(revision&1)return false;
    LONG flags=InterlockedCompareExchange(&shared->flags,0,0);
    candidate.chamsVisible=(flags&1)!=0;candidate.chamsHidden=(flags&2)!=0;candidate.chamsArms=(flags&4)!=0;
    candidate.espEnabled=(flags&8)!=0;candidate.espBoxes=(flags&16)!=0;candidate.espSkeleton=(flags&32)!=0;
    candidate.enemyOnly=InterlockedCompareExchange(&shared->teamFilter,0,0)!=0;
    candidate.chamsGradient=InterlockedCompareExchange(&shared->gradient,0,0)!=0;
    IpcColToFloat4(shared->visibleColour,candidate.colVisible);IpcColToFloat4(shared->hiddenColour,candidate.colHidden);
    IpcColToFloat4(shared->armsColour,candidate.colArms);IpcColToFloat4(shared->gradientColour,candidate.colGradient);
    candidate.materialStyle=InterlockedCompareExchange(&shared->materialStyle,0,0);
    candidate.chamsVisibleStyle=InterlockedCompareExchange(&shared->chamsVisibleStyle,0,0);
    candidate.chamsHiddenStyle=InterlockedCompareExchange(&shared->chamsHiddenStyle,0,0);
    candidate.glowOutline=InterlockedCompareExchange(&shared->outlineGlow,0,0)!=0;
    LONG climate=InterlockedCompareExchange(&shared->climateFlags,0,0);
    candidate.skyActive=(climate&1)!=0;candidate.darkWorld=(climate&2)!=0;
    candidate.skyBrightness=shared->skyBrightness;candidate.worldBrightness=shared->worldBrightness;IpcColToFloat4(shared->skyColour,candidate.colSky);
    candidate.skyboxIndex=InterlockedCompareExchange(&shared->skyboxIndex,0,0);candidate.fogDensity=shared->fogDensity;
    IpcColToFloat4(shared->fogColour,candidate.colFog);candidate.snowParticles=InterlockedCompareExchange(&shared->snowEnabled,0,0)!=0;
    candidate.cleanMap=InterlockedCompareExchange(&shared->cleanMap,0,0)!=0;
    candidate.removeOriginalWeather=InterlockedCompareExchange(&shared->removeWeather,0,0)!=0;
    candidate.agentEnabled=InterlockedCompareExchange(&shared->agentEnabled,0,0)!=0;
    candidate.agentCT=InterlockedCompareExchange(&shared->agentCT,0,0);candidate.agentT=InterlockedCompareExchange(&shared->agentT,0,0);
    candidate.skinsEnabled=false;
    memcpy(candidate.skins,shared->skins,sizeof(candidate.skins));MemoryBarrier();
    if(revision!=InterlockedCompareExchange(&shared->revision,0,0))return false;
    g_cfg=candidate;return true;
}
