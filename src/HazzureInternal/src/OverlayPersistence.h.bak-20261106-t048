static bool Registered(const char* name) {
    if(!name)return false;
    for(const auto& field:boolFields)if(!strcmp(name,field.name))return true;
    for(const auto& field:intFields)if(!strcmp(name,field.name))return true;
    for(const auto& field:floatFields)if(!strcmp(name,field.name))return true;
    for(const auto& field:colourFields)if(!strcmp(name,field.name))return true;
    return g_contextDefaults.find(name)!=g_contextDefaults.end();
}
static void Status(const std::string& text) { sprintf_s(g_configStatusMsg, "%.120s", text.c_str()); }
static bool Invalid(std::string& error, const std::string& name) { error = "Valor invalido: " + name; return false; }
static std::string Text(const Value& value) {
    if (value.IsString()) return std::string(value.GetString(), value.GetStringLength());
    rapidjson::StringBuffer buffer; rapidjson::Writer<rapidjson::StringBuffer> writer(buffer);
    return value.Accept(writer) ? std::string(buffer.GetString(), buffer.GetSize()) : std::string();
}
static bool ReadMap(const Value& object, VarMap& output, std::string& error) {
    if (!object.IsObject() || object.MemberCount() > 256) return Invalid(error,"overrides");
    VarMap candidate;
    for (auto it = object.MemberBegin(); it != object.MemberEnd(); ++it) {
        std::string name(it->name.GetString(),it->name.GetStringLength());
        std::string text = Text(it->value);
        if (name.empty() || name.size() > 128 || name.find('\0') != std::string::npos || text.size() > 4096)
            return Invalid(error,"override");
        candidate.emplace(std::move(name),std::move(text));
    }
    output.swap(candidate); return true;
}
static bool ReadContexts(const Value& object, ContextMap& output, std::string& error) {
    if (!object.IsObject() || object.MemberCount() > 64) return Invalid(error,"contextos");
    ContextMap candidate;
    for (auto it = object.MemberBegin(); it != object.MemberEnd(); ++it) {
        std::string name(it->name.GetString(),it->name.GetStringLength());
        if (name.empty() || name.size() > 128 || name.find('\0') != std::string::npos) return Invalid(error,"contexto");
        if (!ReadMap(it->value,candidate[name],error)) return false;
    }
    output.swap(candidate); return true;
}
static Value WriteMap(const VarMap& input, const Value* previous, Allocator& allocator) {
    Value result(rapidjson::kObjectType);
    for (const auto& item : input) {
        const auto* old = previous ? HazzureConfig::Find(*previous,item.first.c_str()) : nullptr;
        if (old && Text(*old) == item.second) {
            Value copy; copy.CopyFrom(*old,allocator);
            HazzureConfig::SetValue(result,item.first.c_str(),std::move(copy),allocator);
        } else HazzureConfig::Set(result,item.first.c_str(),item.second,allocator);
    }
    return result;
}
static Value WriteContexts(const ContextMap& input, const Value* previous, Allocator& allocator) {
    Value result(rapidjson::kObjectType);
    for (const auto& item : input) {
        const auto* old = previous ? HazzureConfig::Find(*previous,item.first.c_str()) : nullptr;
        HazzureConfig::SetValue(result,item.first.c_str(),WriteMap(item.second,old,allocator),allocator);
    }
    return result;
}
static bool ValidSkin(const SkinConfig& value) {
    if (value.definition < 0 || value.definition > 65535 || value.paint < 0 || value.paint > 20000 ||
        value.seed < 0 || value.seed > 1000 || value.model < 0 || value.model > 65535 ||
        !std::isfinite(value.wear) || value.wear < 0.f || value.wear > 1.f ||
        (value.enabled != 0 && value.enabled != 1) || (value.legacy != 0 && value.legacy != 1)) return false;
    return !value.enabled || value.definition != 0;
}
static bool ReadConfig(const Value& root, OverlayConfig& config, std::string& error) {
    config.skinsEnabled=false; // Ignore retired skinchanger activation in old profiles.
    struct AudioPath {const char* name;char* text;};
    for(auto field:{AudioPath{"hitSoundFile",config.hitSoundFile},AudioPath{"headshotSoundFile",config.headshotSoundFile},AudioPath{"killSoundFile",config.killSoundFile}}){
        if(!HazzureConfig::Find(root,field.name))continue;std::string value;
        if(!HazzureConfig::GetString(root,field.name,value,511)||value.find('\0')!=std::string::npos)return Invalid(error,field.name);
        strcpy_s(field.text,512,value.c_str());
    }
    if(!HazzureLineups::ReadJSON(root,config.lineups,error))return false;
    if(!HazzureArmory::ReadJSON(root,config.armory,error))return false;
    if(!HazzureInventory::ReadJSON(root,config.inventory,error))return false;
    for (const auto& field : boolFields) if (HazzureConfig::Find(root,field.name) &&
        !HazzureConfig::GetBool(root,field.name,config.*field.member,true)) return Invalid(error,field.name);
    // Read the legacy key without preserving its misleading claim when saving.
    if(!HazzureConfig::Find(root,"hideCustomCrosshairScoped")&&HazzureConfig::Find(root,"removeScopedCircle")&&
       !HazzureConfig::GetBool(root,"removeScopedCircle",config.hideCustomCrosshairScoped,true))return Invalid(error,"removeScopedCircle");
    for (const auto& field : intFields) if (HazzureConfig::Find(root,field.name) &&
        !HazzureConfig::GetInt(root,field.name,config.*field.member,field.minimum,field.maximum)) return Invalid(error,field.name);
    for (const auto& field : floatFields) if (HazzureConfig::Find(root,field.name) &&
        !HazzureConfig::GetFloat(root,field.name,config.*field.member,field.minimum,field.maximum)) return Invalid(error,field.name);
    // Old releases shared one duration between tracers and impacts.
    if(!HazzureConfig::Find(root,"impactDuration")&&HazzureConfig::Find(root,"tracerDuration"))config.impactDuration=config.tracerDuration;
    for (const auto& field : colourFields) if (HazzureConfig::Find(root,field.name) &&
        !HazzureConfig::GetFloatArray(root,field.name,config.*field.member,4)) return Invalid(error,field.name);
    if (auto skins = HazzureConfig::Find(root,"skins")) {
        if (!skins->IsArray() || skins->Size() > 64) return Invalid(error,"skins");
        for (rapidjson::SizeType i=0;i<skins->Size();++i) {
            const auto& item=(*skins)[i]; auto& skin=config.skins[i];
            if (!item.IsObject()) return Invalid(error,"skin");
            struct Field { const char* name; int SkinConfig::*member; int low,high; };
            const Field fields[]={{"definition",&SkinConfig::definition,0,65535},{"paint",&SkinConfig::paint,0,20000},
                {"seed",&SkinConfig::seed,0,1000},{"model",&SkinConfig::model,0,65535},
                {"legacy",&SkinConfig::legacy,0,1},{"enabled",&SkinConfig::enabled,0,1},
                {"reserved",&SkinConfig::reserved,(std::numeric_limits<int>::min)(),(std::numeric_limits<int>::max)()}};
            for (const auto& field:fields) if (HazzureConfig::Find(item,field.name) &&
                !HazzureConfig::GetInt(item,field.name,skin.*field.member,field.low,field.high)) return Invalid(error,field.name);
            if (HazzureConfig::Find(item,"wear") && !HazzureConfig::GetFloat(item,"wear",skin.wear,0.f,1.f)) return Invalid(error,"wear");
            if (!ValidSkin(skin)) return Invalid(error,"skin");
        }
    }
    return true;
}
static bool WriteConfig(HazzureConfig::Document& document,const OverlayConfig& config,
                        const ContextMap& contexts,const ContextMap& classes,const std::vector<ConfigProfile>& profiles,
                        int active,std::string& error) {
    auto& root=document.Root(); auto& allocator=document.Allocator();
    struct AudioPath {const char* name;const char* text;};
    for(auto field:{AudioPath{"hitSoundFile",config.hitSoundFile},AudioPath{"headshotSoundFile",config.headshotSoundFile},AudioPath{"killSoundFile",config.killSoundFile}}){
        if(strnlen_s(field.text,512)>=512)return Invalid(error,field.name);
        HazzureConfig::Set(root,field.name,std::string(field.text),allocator);
    }
    if(!HazzureLineups::WriteJSON(root,allocator,config.lineups,error))return false;
    if(!HazzureArmory::WriteJSON(root,allocator,config.armory,error))return false;
    if(!HazzureInventory::WriteJSON(root,allocator,config.inventory,error))return false;
    HazzureConfig::Set(root,"skinsEnabled",false,allocator);
    for (const auto& field:boolFields) HazzureConfig::Set(root,field.name,config.*field.member,allocator);
    for (const auto& field:intFields) {
        int value=config.*field.member; if(value<field.minimum||value>field.maximum)return Invalid(error,field.name);
        HazzureConfig::Set(root,field.name,value,allocator);
    }
    for (const auto& field:floatFields) {
        float value=config.*field.member;
        if(!std::isfinite(value)||value<field.minimum||value>field.maximum)return Invalid(error,field.name);
        HazzureConfig::Set(root,field.name,static_cast<double>(value),allocator);
    }
    for (const auto& field:colourFields) {
        const auto& colour=config.*field.member;
        for(float component:colour)if(!std::isfinite(component)||component<0.f||component>1.f)return Invalid(error,field.name);
        HazzureConfig::SetFloatArray(root,field.name,colour,4,allocator);
    }
    Value skins(rapidjson::kArrayType); const auto* oldSkins=HazzureConfig::Find(root,"skins");
    for(unsigned i=0;i<64;++i) {
        const auto& skin=config.skins[i];if(!ValidSkin(skin))return Invalid(error,"skin");
        Value item(rapidjson::kObjectType);
        if(oldSkins&&oldSkins->IsArray()&&i<oldSkins->Size()&&(*oldSkins)[i].IsObject())item.CopyFrom((*oldSkins)[i],allocator);
        HazzureConfig::Set(item,"definition",skin.definition,allocator);HazzureConfig::Set(item,"paint",skin.paint,allocator);
        HazzureConfig::Set(item,"seed",skin.seed,allocator);HazzureConfig::Set(item,"model",skin.model,allocator);
        HazzureConfig::Set(item,"wear",static_cast<double>(skin.wear),allocator);
        HazzureConfig::Set(item,"legacy",skin.legacy,allocator);HazzureConfig::Set(item,"enabled",skin.enabled,allocator);
        HazzureConfig::Set(item,"reserved",skin.reserved,allocator);skins.PushBack(item,allocator);
    }
    HazzureConfig::SetValue(root,"skins",std::move(skins),allocator);
    auto newContexts=WriteContexts(contexts,HazzureConfig::Find(root,"contexts"),allocator);
    auto newClasses=WriteContexts(classes,HazzureConfig::Find(root,"weaponClasses"),allocator);
    HazzureConfig::SetValue(root,"contexts",std::move(newContexts),allocator);
    HazzureConfig::SetValue(root,"weaponClasses",std::move(newClasses),allocator);
    Value array(rapidjson::kArrayType);const auto* previous=HazzureConfig::Find(root,"profiles");
    for(const auto& profile:profiles) {
        Value item(rapidjson::kObjectType);
        if(previous&&previous->IsArray())for(const auto& old:previous->GetArray()) {
            std::string name;
            if(HazzureConfig::GetString(old,"name",name,128)&&name==profile.name){item.CopyFrom(old,allocator);break;}
        }
        HazzureConfig::Set(item,"name",profile.name,allocator);
        auto overrides=WriteMap(profile.overrides,HazzureConfig::Find(item,"overrides"),allocator);
        auto ctx=WriteContexts(profile.contexts,HazzureConfig::Find(item,"contexts"),allocator);
        auto wp=WriteContexts(profile.weaponClasses,HazzureConfig::Find(item,"weaponClasses"),allocator);
        HazzureConfig::SetValue(item,"overrides",std::move(overrides),allocator);
        HazzureConfig::SetValue(item,"contexts",std::move(ctx),allocator);
        HazzureConfig::SetValue(item,"weaponClasses",std::move(wp),allocator);array.PushBack(item,allocator);
    }
    HazzureConfig::SetValue(root,"profiles",std::move(array),allocator);
    HazzureConfig::Set(root,"activeProfile",active>=0&&active<static_cast<int>(profiles.size())?profiles[active].name:std::string(),allocator);
    HazzureConfig::Set(root,"activeProfileIndex",active,allocator);HazzureConfig::Set(root,"schemaVersion",3,allocator);
    return true;
}
static bool ReadProfiles(const Value& root,ContextMap& contexts,ContextMap& classes,
                         std::vector<ConfigProfile>& profiles,int& active,std::string& error) {
    if(auto value=HazzureConfig::Find(root,"contexts"))if(!ReadContexts(*value,contexts,error))return false;
    if(auto value=HazzureConfig::Find(root,"weaponClasses"))if(!ReadContexts(*value,classes,error))return false;
    if(auto value=HazzureConfig::Find(root,"profiles")) {
        if(!value->IsArray()||value->Size()>64)return Invalid(error,"profiles");
        std::vector<ConfigProfile> candidate;std::set<std::string> names;
        for(const auto& item:value->GetArray()) {
            ConfigProfile profile;
            if(!HazzureConfig::GetString(item,"name",profile.name,128)||profile.name.empty()||
               profile.name.find('\0')!=std::string::npos||!names.insert(profile.name).second)return Invalid(error,"profile.name");
            if(auto v=HazzureConfig::Find(item,"overrides"))if(!ReadMap(*v,profile.overrides,error))return false;
            if(auto v=HazzureConfig::Find(item,"contexts"))if(!ReadContexts(*v,profile.contexts,error))return false;
            if(auto v=HazzureConfig::Find(item,"weaponClasses"))if(!ReadContexts(*v,profile.weaponClasses,error))return false;
            candidate.push_back(std::move(profile));
        }
        profiles.swap(candidate);
    }
    if(HazzureConfig::Find(root,"activeProfile")) {
        std::string name;if(!HazzureConfig::GetString(root,"activeProfile",name,128))return Invalid(error,"activeProfile");
        active=-1;
        for(size_t i=0;i<profiles.size();++i)if(profiles[i].name==name){active=static_cast<int>(i);break;}
        if(active<0&&!name.empty())return Invalid(error,"activeProfile");
    } else if(HazzureConfig::Find(root,"activeProfileIndex")) {
        if(!HazzureConfig::GetInt(root,"activeProfileIndex",active,-1,static_cast<int>(profiles.size())-1))return Invalid(error,"activeProfileIndex");
    } else if(active>=static_cast<int>(profiles.size()))active=profiles.empty()?-1:0;
    return true;
}
static bool Publish(Shared* shared,const OverlayConfig& config) {
    if(!shared)return true;
    LONG revision=0;bool acquired=false;
    for(int attempt=0;attempt<64;++attempt) {
        revision=InterlockedCompareExchange(&shared->revision,0,0);
        if(!(revision&1)&&InterlockedCompareExchange(&shared->revision,
            static_cast<LONG>(static_cast<uint32_t>(revision)+1u),revision)==revision){acquired=true;break;}
        YieldProcessor();
    }
    if(!acquired)return false;
    InterlockedExchange(&shared->uiConfigOwner,1);
    LONG bits=(config.chamsVisible?1:0)|(config.chamsHidden?2:0)|(config.chamsArms?4:0)|
        (config.espEnabled?8:0)|(config.espBoxes?16:0)|(config.espSkeleton?32:0);
    LONG before=InterlockedCompareExchange(&shared->flags,0,0);
    while(InterlockedCompareExchange(&shared->flags,(before&~0x3f)|bits,before)!=before)
        before=InterlockedCompareExchange(&shared->flags,0,0);
    InterlockedExchange(&shared->teamFilter,config.enemyOnly?1:0);
    InterlockedExchange(&shared->gradient,config.chamsGradient?1:0);
    shared->visibleColour=Float4ToIpcCol(config.colVisible);shared->hiddenColour=Float4ToIpcCol(config.colHidden);
    shared->armsColour=Float4ToIpcCol(config.colArms);shared->gradientColour=Float4ToIpcCol(config.colGradient);
    InterlockedExchange(&shared->materialStyle,config.materialStyle);InterlockedExchange(&shared->outlineGlow,config.glowOutline?1:0);
    InterlockedExchange(&shared->chamsVisibleStyle,config.chamsVisibleStyle);InterlockedExchange(&shared->chamsHiddenStyle,config.chamsHiddenStyle);
    InterlockedExchange(&shared->climateFlags,(config.skyActive?1:0)|(config.darkWorld?2:0));
    shared->skyBrightness=config.skyBrightness;shared->worldBrightness=config.worldBrightness;shared->skyColour=Float4ToIpcCol(config.colSky);
    InterlockedExchange(&shared->skyboxIndex,config.skyboxIndex);shared->fogDensity=config.fogDensity;shared->fogColour=Float4ToIpcCol(config.colFog);
    InterlockedExchange(&shared->snowEnabled,config.snowParticles?1:0);InterlockedExchange(&shared->cleanMap,config.cleanMap?1:0);
    InterlockedExchange(&shared->removeWeather,config.removeOriginalWeather?1:0);
    InterlockedExchange(&shared->agentEnabled,config.agentEnabled?1:0);InterlockedExchange(&shared->agentCT,config.agentCT);
    InterlockedExchange(&shared->agentT,config.agentT);InterlockedExchange(&shared->skinEnabled,0);
    memcpy(shared->skins,config.skins,sizeof(config.skins));
    HazzureArmory::Publish(config.armory);MemoryBarrier();
    InterlockedExchange(&shared->revision,static_cast<LONG>(static_cast<uint32_t>(revision)+2u));return true;
}
