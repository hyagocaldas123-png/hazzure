// Exponential response has the same endpoint at any frame rate; only colors use it.
static float Approach(float value,float target,float dt) {
    if(!std::isfinite(dt)||dt<=0)return value;
    return target+(value-target)*std::exp(-12.f*std::min(dt,.25f));
}
static std::string Fold(const char* text) {
    std::string out;if(!text)return out;
    for(const unsigned char* p=reinterpret_cast<const unsigned char*>(text);*p;++p){
        unsigned c=*p;
        if(c==0xc3&&p[1]){c=*++p;
            if((c>=0x80&&c<=0x85)||(c>=0xa0&&c<=0xa5))c='a';
            else if(c==0x87||c==0xa7)c='c';
            else if((c>=0x88&&c<=0x8b)||(c>=0xa8&&c<=0xab))c='e';
            else if((c>=0x8c&&c<=0x8f)||(c>=0xac&&c<=0xaf))c='i';
            else if((c>=0x92&&c<=0x96)||(c>=0xb2&&c<=0xb6))c='o';
            else if((c>=0x99&&c<=0x9c)||(c>=0xb9&&c<=0xbc))c='u';
        }
        if(c>='A'&&c<='Z')c+='a'-'A';out.push_back(static_cast<char>(c));
    }return out;
}
static bool Matches(const char* text,const char* query) {return Fold(text).find(Fold(query))!=std::string::npos;}
static const char* Observed(bool requested,bool available,bool applied,const char* waiting) {
    return !requested?"Desativado":!available?"Indisponivel: backend sem contrato validado":applied?"Ativo (confirmado pelo runtime)":waiting;
}
