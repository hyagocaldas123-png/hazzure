static bool LoadConfigFile(const char* path="C:\\HazzureKernel\\hazzure_config.json") {
    if(!path||!*path){Persistence::Status("Caminho de configuracao invalido");return false;}
    HazzureConfig::Document candidate;std::string error;
    if(!candidate.Load(path,error)){Persistence::Status(error);return false;}
    int version=1;
    if(HazzureConfig::Find(candidate.Root(),"schemaVersion")&&
       !HazzureConfig::GetInt(candidate.Root(),"schemaVersion",version,1,3)){Persistence::Status("schemaVersion nao suportada");return false;}
    OverlayConfig config{};auto contexts=g_contexts;auto classes=g_weaponClasses;auto profiles=g_profiles;int active=g_activeProfileIndex;
    if(!Persistence::ReadConfig(candidate.Root(),config,error)||
       !Persistence::ReadProfiles(candidate.Root(),contexts,classes,profiles,active,error)){Persistence::Status(error);return false;}
    if(version<3&&(!Persistence::WriteConfig(candidate,config,contexts,classes,profiles,active,error)||
                   !candidate.SaveAtomic(path,error,version))){Persistence::Status(error);return false;}
    if(!Persistence::Publish(g_settingsShared,config)){Persistence::Status("Configuracao IPC ocupada; tente novamente");return false;}
    g_cfg=config;g_contexts.swap(contexts);g_weaponClasses.swap(classes);g_profiles.swap(profiles);g_activeProfileIndex=active;
    RefreshCustomAudio();
    Persistence::storage=candidate;Persistence::storagePath=path;Workflow::MarkSaved();

    // Validar índices de navegação após carregar config (defesa em profundidade)
    ValidateNavigationIndices();

    Persistence::Status(version<3?"Configuracao migrada para v3 com backup":"Configuracao completa carregada (v3)");return true;
}

static void SynchronizeSkinsAfterProfileChange() {
    if (g_settingsShared) {
        ApplySharedConfig(g_settingsShared);
    }
    HazzureArmory::Publish(g_cfg.armory);
}

static void OnProfileApplied(int profileIndex) {
    if (profileIndex >= 0 && profileIndex < static_cast<int>(g_profiles.size())) {
        g_activeProfileIndex = profileIndex;
        for (const auto& kv : g_profiles[profileIndex].overrides) {
            for (const auto& field : Persistence::boolFields) {
                if (kv.first == field.name) g_cfg.*field.member = (kv.second == "1" || kv.second == "true");
            }
            for (const auto& field : Persistence::intFields) {
                if (kv.first == field.name) g_cfg.*field.member = atoi(kv.second.c_str());
            }
            for (const auto& field : Persistence::floatFields) {
                if (kv.first == field.name) g_cfg.*field.member = static_cast<float>(atof(kv.second.c_str()));
            }
        }
        SynchronizeSkinsAfterProfileChange();
        Persistence::Status("Perfil ativo aplicado: " + g_profiles[profileIndex].name);
    }
}

static bool PollAndHotReloadConfig(const char* path = "C:\\HazzureKernel\\hazzure_config.json", uint64_t currentTick = 0) {
    if (!currentTick) currentTick = GetTickCount64();
    if (path && Persistence::g_configWatcher.path.empty()) {
        Persistence::g_configWatcher.path = HazzureConfig::Detail::Normalize(path).wstring();
    }
    if (Persistence::g_configWatcher.HasFileChanged(currentTick, 500)) {
        if (LoadConfigFile(path)) {
            SynchronizeSkinsAfterProfileChange();
            Persistence::Status("Configuracao recarregada via Hot-Reload");
            return true;
        }
    }
    return false;
}
